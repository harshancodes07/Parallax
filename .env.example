# Copy to .env and fill in. Never commit the real .env.

# --- LLM provider: fill in ONE of these ---
# Gemini has a free tier and needs no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier, fast, open models): https://console.groq.com/keys
GROQ_API_KEY=
# xAI / Grok (paid): https://console.x.ai
XAI_API_KEY=
# Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: gemini | groq | grok (xai) | anthropic. Blank = auto-pick by whichever key is set.
LLM_PROVIDER=
# Optional: override the model, e.g. openai/gpt-oss-120b on Groq
LLM_MODEL=

LLM_API_KEY=
EMBEDDING_MODEL=
VECTOR_STORE_PATH=./data/vectorstore
OCR_ENGINE=tesseract
TARGET_LANGUAGE=
