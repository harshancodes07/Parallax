# Copy to .env and fill in. Never commit the real .env.

# --- LLM provider: fill in ONE of these ---
# Gemini has a free tier and needs no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Leave blank to auto-pick whichever key above is set.
LLM_PROVIDER=

LLM_API_KEY=
EMBEDDING_MODEL=

# --- RAG / grounding ---
EMBED_MODEL=intfloat/multilingual-e5-base
RAG_SCORE_THRESHOLD=0.81
ANSWER_MODEL=claude-opus-5

# Translate the query to English before embedding. Leave OFF when the tutor is
# the caller: it already translates in query_prep, and translating twice costs a
# second model call and lets the wording drift before it reaches retrieval.
TRANSLATE_QUERIES=0
TRANSLATE_MODEL=claude-opus-5

# Second grounding gate. Similarity alone cannot reject a same-subject question
# that the page does not answer ("respiration" scores 0.844 against a
# photosynthesis page; the worst genuine in-scope question scores 0.846), so the
# adapter asks the model before reporting a page in scope. Costs one call per
# question and saves a whole lesson generation when it refuses.
RAG_SCOPE_CHECK=1

VECTOR_STORE_PATH=./data/vectorstore
OCR_ENGINE=tesseract
TARGET_LANGUAGE=
